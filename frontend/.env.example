# Public build-time configuration; no real credentials or server secrets here.
# Copy to .env.local, then enter your own project URL and publishable key.
VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only the publishable key belongs here. NEVER use SUPABASE_SECRET_KEY/service_role.
# Production: VITE_API_BASE_URL=https://YOUR_BACKEND.onrender.com (no /docs path).
# Production: VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY must use the sb_publishable_ prefix.
# Configure these in Netlify and rebuild when values change.
