# LOCAL DEVELOPMENT — SQLite/local uploads, Supabase Auth for real accounts.
# Export values in your shell; the backend does not automatically load .env files.
APP_ENV=development
DATABASE_URL=
IMAGE_STORAGE=local
WARDROBE_DATA_DIR=
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=clothing-images
SUPABASE_SECRET_KEY=
# Empty DATABASE_URL / WARDROBE_DATA_DIR keep project-root wardrobe.db and uploads/.
# Login requires SUPABASE_URL + server-only SUPABASE_SECRET_KEY even in local mode.
# Never use the publishable frontend key as this server credential.

# RENDER PRODUCTION — enter these overrides in the service's Environment dashboard.
# Do not deploy the active local settings above. Replace placeholders yourself.
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# IMAGE_STORAGE=supabase
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_STORAGE_BUCKET=clothing-images
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_IN_RENDER_DASHBOARD_ONLY
# FRONTEND_ORIGINS=https://wonderful-quokka-3c636d.netlify.app
# Copy the exact Session pooler URI/host from Supabase Connect (port 5432).
# Percent-encode reserved characters in the DATABASE_URL password, e.g. @ -> %40.
# DATABASE_URL and SUPABASE_SECRET_KEY are SECRETS: backend-only, never VITE_* or Git.
# Obtain the Secret key in Settings > API Keys; do not use the publishable/anon key.
# Auth reuses SUPABASE_URL/SUPABASE_SECRET_KEY; no JWT secret or new Render env is needed.
# Before production: private bucket + docs/supabase-multi-user.sql RLS guards are required.
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY (only if SUPABASE_SECRET_KEY is unset).
# WARDROBE_DATA_DIR is not needed in production. No local-disk fallback is allowed.
# Start Command (Render Settings > Build & Deploy):
# python -m app.migrate && python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 1
